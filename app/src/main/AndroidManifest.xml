<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase, the SMTP connection for verification codes, OpenStreetMap
         tiles and Photon place search -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- osmdroid checks the network before downloading map tiles -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground location only: read when the student taps Check in, or when
         the lecturer taps "Use my location". Never background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:name=".AttendraApp"
        android:theme="@style/Theme.AttendraUiTM">
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.lecturer.LecturerMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.StudentMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.ClassDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.MyClubsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.PreferredNameActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.common.ComingSoonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.session.CreateSessionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.lecturer.LiveMonitorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lecturer.SessionReportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.CheckInActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.CheckInResultActivity"
            android:exported="false" />

        <!-- Shares the Session Report CSV with other apps (email, Drive) without
             any storage permission. Only cache/reports/ is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>