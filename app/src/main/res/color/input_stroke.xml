<?xml version="1.0" encoding="utf-8"?>
<!-- Text field outline: gold when focused, line colour otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/gold" android:state_focused="true" />
    <item android:color="@color/muted" android:state_hovered="true" />
    <item android:color="@color/line" />
</selector>
