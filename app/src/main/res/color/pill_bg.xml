<?xml version="1.0" encoding="utf-8"?>
<!-- Pill (filter chip) fill: light gold tint when selected, surface otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.16" android:color="@color/gold" android:state_checked="true" />
    <item android:color="@color/surface" />
</selector>
