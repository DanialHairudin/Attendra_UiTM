<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope body family. Regular (400) is the default; textStyle="bold" picks 700.
     For SemiBold or ExtraBold, point fontFamily straight at @font/manrope_semibold
     or @font/manrope_extrabold. Both android: and app: attributes are set so the
     family also works on API 24-25 through AppCompat. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/manrope_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/manrope_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
