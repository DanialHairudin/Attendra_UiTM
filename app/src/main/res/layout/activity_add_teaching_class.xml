<?xml version="1.0" encoding="utf-8"?>
<!-- Add Teaching Class Page (wireframe "13. Add Teaching Class Page", C5b).
     Semester → Programme → Part → Course → Groups, then Save classes / Cancel.
     The same page edits a class, and is the "Set up your teaching classes"
     step after a new lecturer picks a preferred name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/teach_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/appbar"
        layout="@layout/include_appbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- First-time setup only (the app bar is hidden then). -->
            <TextView
                android:id="@+id/txt_setup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/teach_setup_title"
                android:textAppearance="@style/TextAppearance.Attendra.H2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_teach_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/teach_body"
                android:textAppearance="@style/TextAppearance.Attendra.Body.Muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_teach_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/loading"
                android:textAppearance="@style/TextAppearance.Attendra.Caption" />

            <LinearLayout
                android:id="@+id/group_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/input_semester"
                    android:text="@string/label_semester" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_semester"
                    style="@style/Widget.Attendra.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/input_semester"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/input_programme"
                    android:text="@string/label_programme" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_programme"
                    style="@style/Widget.Attendra.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/input_programme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_programme"
                        android:inputType="none"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/input_part"
                    android:text="@string/label_part" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_part"
                    style="@style/Widget.Attendra.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/input_part"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_part"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/input_course"
                    android:text="@string/label_course" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_course"
                    style="@style/Widget.Attendra.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/input_course"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_course"
                        android:inputType="none"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_groups" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/list_groups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="4dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/txt_groups_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/teach_error_groups"
                    android:textAppearance="@style/TextAppearance.Attendra.Caption"
                    android:textColor="@color/rejected"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/Widget.Attendra.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="24dp"
                    android:text="@string/teach_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Attendra.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="10dp"
                    android:text="@string/cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_skip"
                    style="@style/Widget.Attendra.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/teach_skip"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
