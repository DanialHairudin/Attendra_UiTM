<?xml version="1.0" encoding="utf-8"?>
<!-- Check-in result ("result" in the prototype): Present, Late or Rejected. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/result_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <FrameLayout
            android:id="@+id/result_icon_bg"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_circle">

            <ImageView
                android:id="@+id/result_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/result_badge"
            style="@style/Widget.Attendra.Badge"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Attendra.H1" />

        <TextView
            android:id="@+id/result_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:maxWidth="320dp"
            android:textAppearance="@style/TextAppearance.Attendra.Body.Muted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Attendra.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:id="@+id/result_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_try_again"
            style="@style/Widget.Attendra.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="22dp"
            android:text="@string/try_again"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home"
            style="@style/Widget.Attendra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="10dp"
            android:text="@string/back_to_home" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
