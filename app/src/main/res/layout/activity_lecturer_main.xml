<?xml version="1.0" encoding="utf-8"?>
<!-- Lecturer area: one tab Fragment at a time + bottom nav
     Home · Classes · (+) · History · Settings (CLAUDE.md 12.5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- The (+) button sits on top of the empty middle item of the nav. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            app:menu="@menu/nav_lecturer"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fab"
            style="@style/Widget.Attendra.Fab"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/create_session" />
    </FrameLayout>
</LinearLayout>
