<?xml version="1.0" encoding="utf-8"?>
<!-- Lecturer Dashboard Page (CLAUDE.md 12.5), matching "lHome" in the prototype. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="24dp">

        <!-- Header: date, greeting, avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Attendra.Caption" />

                <TextView
                    android:id="@+id/txt_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Attendra.H2" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_avatar"
                style="@style/Widget.Attendra.Avatar"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:contentDescription="@string/open_profile"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Live-session card: only while one of the lecturer's sessions is open -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_live"
            style="@style/Widget.Attendra.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.Attendra.Badge.Present"
                        android:text="@string/live_now" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txt_live_closes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Attendra.Caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_live_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.Attendra.H2" />

                <TextView
                    android:id="@+id/txt_live_course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Attendra.Caption" />

                <TextView
                    android:id="@+id/txt_live_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Attendra.Caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/Widget.Attendra.Tile">

                        <TextView
                            android:id="@+id/txt_count_checked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Attendra.Number"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/count_checked_in"
                            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.Attendra.Tile"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/txt_count_expected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Attendra.Number"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/count_expected"
                            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.Attendra.Tile"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/txt_count_rejected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Attendra.Number"
                            android:textColor="@color/rejected"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/count_rejected"
                            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_live_monitor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="14dp"
                    android:text="@string/open_live_monitor" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Today -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/today"
                android:textAppearance="@style/TextAppearance.Attendra.H3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_see_history"
                style="@style/Widget.Attendra.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_history" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/list_today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <include
                    android:id="@+id/empty_today"
                    layout="@layout/view_empty"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txt_today_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/loading"
                    android:textAppearance="@style/TextAppearance.Attendra.Caption" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_session"
            style="@style/Widget.Attendra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="18dp"
            android:text="@string/create_session"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart"
            app:iconTint="@color/ink" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
