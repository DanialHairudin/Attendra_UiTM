<?xml version="1.0" encoding="utf-8"?>
<!-- My attendance tab: overall percentage, one card per course, then the student's history (newest first). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/my_attendance_title"
            android:textAppearance="@style/TextAppearance.Attendra.H2" />

        <!-- 92% · 41 present · 5 late · 4 absent · of 50 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Attendra.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txt_overall_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:minWidth="72dp"
                    android:textAppearance="@style/TextAppearance.Attendra.Number.Big" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_present"
                            style="@style/Widget.Attendra.Badge.Present" />

                        <TextView
                            android:id="@+id/chip_late"
                            style="@style/Widget.Attendra.Badge.Late"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_absent"
                            style="@style/Widget.Attendra.Badge.Absent" />

                        <TextView
                            android:id="@+id/txt_of_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txt_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading"
            android:textAppearance="@style/TextAppearance.Attendra.Caption" />

        <!-- No attendance yet -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_empty"
            style="@style/Widget.Attendra.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty" />
        </com.google.android.material.card.MaterialCardView>

        <!-- One card per course -->
        <LinearLayout
            android:id="@+id/list_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- History -->
        <LinearLayout
            android:id="@+id/group_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="@string/my_history_title"
                android:textAppearance="@style/TextAppearance.Attendra.H3" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Attendra.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:id="@+id/list_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- "Show hidden sessions": shown only when the student has hidden any -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_show_hidden"
            style="@style/Widget.Attendra.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <include
                android:id="@+id/row_show_hidden"
                layout="@layout/item_switch_row" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
