<?xml version="1.0" encoding="utf-8"?>
<!-- Register, matching the "Register" screen of the prototype. One form for both
     roles; the Student | Lecturer toggle shows or hides the role-only fields.

     Scrolling: the root is a NestedScrollView with ONE child, so the whole screen
     (app bar included) scrolls as one piece. fillViewport makes the child at least
     screen-tall. When the keyboard opens, BaseActivity pads the screen by the
     keyboard height, the scroll view gets shorter, and it scrolls the focused
     field back into view by itself. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/appbar"
            layout="@layout/include_appbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/attendra_logo" />

            <!-- Role toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_role_student"
                    style="@style/Widget.Attendra.Segment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:text="@string/role_student" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_role_lecturer"
                    style="@style/Widget.Attendra.Segment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:text="@string/role_lecturer" />
            </LinearLayout>

            <!-- Full name (both roles) -->
            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/input_name"
                android:text="@string/label_full_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:hint="@string/hint_full_name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Student ID (student only) -->
            <LinearLayout
                android:id="@+id/group_student_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/input_student_id"
                    android:text="@string/label_student_id" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_student_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="10">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_student_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_student_id"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="10" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Staff ID (lecturer only) -->
            <LinearLayout
                android:id="@+id/group_staff_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/input_staff_id"
                    android:text="@string/label_staff_id" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_staff_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_staff_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_staff_id"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions|textCapCharacters" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Email (label text changes with the role) -->
            <TextView
                android:id="@+id/txt_label_email"
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/input_email"
                android:text="@string/label_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="@string/hint_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone with a fixed +60 prefix -->
            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/input_phone"
                android:text="@string/label_phone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:expandedHintEnabled="false"
                app:prefixText="@string/phone_prefix"
                app:prefixTextColor="@color/ink">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phoneNational"
                    android:hint="@string/hint_phone"
                    android:imeOptions="actionNext"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Programme → Part → Group (student only). Each choice filters the next. -->
            <LinearLayout
                android:id="@+id/group_academic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Attendra.FieldLabel"
                    android:layout_marginTop="14dp"
                    android:labelFor="@id/input_programme"
                    android:text="@string/label_programme" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_programme"
                    style="@style/Widget.Attendra.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/input_programme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_programme"
                        android:inputType="none"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Attendra.FieldLabel"
                            android:labelFor="@id/input_part"
                            android:text="@string/label_part" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_part"
                            style="@style/Widget.Attendra.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/input_part"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_part"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Attendra.FieldLabel"
                            android:labelFor="@id/input_group"
                            android:text="@string/label_group" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_group"
                            style="@style/Widget.Attendra.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/input_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_group"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Clubs: optional pills, one line, scroll sideways -->
            <TextView
                android:id="@+id/txt_label_clubs"
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/label_clubs_student" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginEnd="-20dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_clubs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/txt_clubs_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/clubs_optional_note"
                android:textAppearance="@style/TextAppearance.Attendra.Caption" />

            <!-- Password + confirm -->
            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/input_password"
                android:text="@string/label_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/hint_password_new"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@id/input_confirm"
                android:text="@string/label_confirm_password" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="@string/hint_confirm_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="20dp"
                android:text="@string/create_account_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/register_footer"
                android:textAppearance="@style/TextAppearance.Attendra.Caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
