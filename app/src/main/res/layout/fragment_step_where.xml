<?xml version="1.0" encoding="utf-8"?>
<!-- Step 3, Session Venue Page + Room Selection ("cWhere" in the prototype). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txt_type_badge"
            style="@style/Widget.Attendra.Badge.Gold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityHeading="true"
            android:text="@string/where_question"
            android:textAppearance="@style/TextAppearance.Attendra.H2" />

        <!-- Club only: Inside faculty | Outside -->
        <LinearLayout
            android:id="@+id/segment_inside"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_inside"
                style="@style/Widget.Attendra.Segment"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:text="@string/where_inside" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_outside"
                style="@style/Widget.Attendra.Segment"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:text="@string/where_outside" />
        </LinearLayout>

        <!-- Building + room (Class, Test, Club inside) -->
        <LinearLayout
            android:id="@+id/group_building"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/input_building"
                android:text="@string/where_building" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_building"
                style="@style/Widget.Attendra.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/input_building"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/where_building_hint"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Shown when the building's lat/lng is still 0 -->
            <LinearLayout
                android:id="@+id/note_no_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_error_note"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/where_no_location_title"
                    android:textColor="@color/rejected"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txt_no_location_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textAppearance="@style/TextAppearance.Attendra.Body.Muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/input_room"
                android:text="@string/where_room" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_room"
                style="@style/Widget.Attendra.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/input_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/where_room_hint"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- "Geofence set automatically" -->
            <LinearLayout
                android:id="@+id/note_geofence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_note"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_target"
                    app:tint="@color/goldText" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/where_geofence_title"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_geofence_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textAppearance="@style/TextAppearance.Attendra.Body.Muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- OpenStreetMap venue map (view_venue_pin.xml + map/VenuePinMap).
             Map pin mode (SULAM, Club outside): search, editable pin, "Use my location".
             Building mode (Class, Test, Club inside): read-only preview of the
             building's geofence, shown once a building with a location is chosen. -->
        <include
            android:id="@+id/venue_pin"
            layout="@layout/view_venue_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_pin_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Attendra.Caption"
            android:visibility="gone" />

        <!-- Radius 30–150 m (all types) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:labelFor="@id/slider_radius"
                android:text="@string/where_radius" />

            <TextView
                android:id="@+id/txt_radius"
                style="@style/Widget.Attendra.Badge.Gold"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_radius"
            style="@style/Widget.Attendra.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="30"
            android:valueTo="150" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/where_radius_min"
                android:textAppearance="@style/TextAppearance.Attendra.Caption" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/where_radius_max"
                android:textAppearance="@style/TextAppearance.Attendra.Caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
