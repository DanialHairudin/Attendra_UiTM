<?xml version="1.0" encoding="utf-8"?>
<!-- Step 2, Session Participants Page. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txt_type_badge"
            style="@style/Widget.Attendra.Badge.Gold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityHeading="true"
            android:text="@string/who_question"
            android:textAppearance="@style/TextAppearance.Attendra.H2" />

        <TextView
            android:id="@+id/txt_title_label"
            style="@style/Widget.Attendra.FieldLabel"
            android:layout_marginTop="16dp"
            android:labelFor="@id/input_title"
            android:text="@string/who_session_title" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Class / course / club picker -->
        <TextView
            android:id="@+id/txt_pick_label"
            style="@style/Widget.Attendra.FieldLabel"
            android:layout_marginTop="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/list_pick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <include
                    android:id="@+id/empty_pick"
                    layout="@layout/view_empty"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SULAM: "Add CDCS2406C in Teaching Classes to include it." -->
        <TextView
            android:id="@+id/txt_sulam_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Attendra.Caption"
            android:visibility="gone" />

        <!-- Test only: groups of the chosen course -->
        <LinearLayout
            android:id="@+id/group_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_groups_label"
                style="@style/Widget.Attendra.FieldLabel"
                android:layout_marginTop="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/list_groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Club only -->
        <LinearLayout
            android:id="@+id/note_club"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_note"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/goldText" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/who_club_note"
                android:textAppearance="@style/TextAppearance.Attendra.Body.Muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- "CDCS2405A · 32 students" -->
        <TextView
            android:id="@+id/txt_summary"
            style="@style/Widget.Attendra.Badge.Gold"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
