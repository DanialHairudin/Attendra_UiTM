<?xml version="1.0" encoding="utf-8"?>
<!-- "Check your inbox", matching the "Verify email" screen of the prototype. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_verify_icon">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mail"
                app:tint="@color/goldText" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityHeading="true"
            android:text="@string/verify_title"
            android:textAppearance="@style/TextAppearance.Attendra.H1" />

        <!-- Filled in code so the email address can be bold -->
        <TextView
            android:id="@+id/txt_verify_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingMultiplier="1.2"
            android:textAppearance="@style/TextAppearance.Attendra.Body.Muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verified"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="22dp"
            android:text="@string/verify_done" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resend"
            style="@style/Widget.Attendra.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:text="@string/verify_resend" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verify_wrong_email"
                android:textAppearance="@style/TextAppearance.Attendra.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_email"
                style="@style/Widget.Attendra.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verify_change_it" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_login"
            style="@style/Widget.Attendra.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_to_login" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
