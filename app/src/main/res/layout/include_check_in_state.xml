<?xml version="1.0" encoding="utf-8"?>
<!-- One of the check-in states: Permission needed, GPS off, Low accuracy, Offline, Session closed,
     Not in this session. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="28dp">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_verify_icon">

        <ImageView
            android:id="@+id/state_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/goldText" />
    </FrameLayout>

    <TextView
        android:id="@+id/state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Attendra.H1" />

    <TextView
        android:id="@+id/state_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.2"
        android:textAppearance="@style/TextAppearance.Attendra.Body.Muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/state_primary"
        style="@style/Widget.Attendra.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/state_secondary"
        style="@style/Widget.Attendra.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="10dp"
        android:text="@string/not_now" />
</LinearLayout>
