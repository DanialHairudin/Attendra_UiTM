<?xml version="1.0" encoding="utf-8"?>
<!-- One club: star icon, short name, full name, and an optional gold badge
     (member count on the Classes tab). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Attendra.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@null"
    android:orientation="horizontal">

    <ImageView
        style="@style/Widget.Attendra.IconTile"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_star"
        app:tint="@color/goldText" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/club_short"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Attendra.RowTitle"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/club_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/club_badge"
        style="@style/Widget.Attendra.Badge.Gold"
        android:layout_marginStart="12dp"
        android:visibility="gone" />
</LinearLayout>
