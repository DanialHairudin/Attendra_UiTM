<?xml version="1.0" encoding="utf-8"?>
<!-- One course in the student's "My courses" list: name, percentage bar, percentage. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Attendra.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/course_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Attendra.RowTitle"
            android:textSize="14sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/course_bar"
            style="@style/Widget.Attendra.Bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:max="100" />
    </LinearLayout>

    <TextView
        android:id="@+id/course_pct"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_bold"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:textColor="@color/ink"
        android:textSize="15sp" />
</LinearLayout>
