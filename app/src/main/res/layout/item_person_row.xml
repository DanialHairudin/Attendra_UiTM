<?xml version="1.0" encoding="utf-8"?>
<!-- One student in a class roster: initials avatar, name, "student ID · group". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Attendra.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@null"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/person_avatar"
        style="@style/Widget.Attendra.Avatar"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/person_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Attendra.RowTitle"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/person_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
    </LinearLayout>
</LinearLayout>
