<?xml version="1.0" encoding="utf-8"?>
<!-- One session in the lecturer's "Today" list: icon, title, groups · room · time, status chip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Attendra.ListRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/row_icon"
        style="@style/Widget.Attendra.IconTile"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Attendra.RowTitle" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Attendra.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_chip"
        style="@style/Widget.Attendra.Badge.Gold"
        android:layout_marginStart="12dp" />
</LinearLayout>
