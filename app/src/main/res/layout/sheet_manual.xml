<?xml version="1.0" encoding="utf-8"?>
<!-- Manual Attendance Page as a bottom sheet ("Mark manually" in the prototype). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/manual_title"
        android:textAppearance="@style/TextAppearance.Attendra.H3"
        android:textSize="18sp" />

    <TextView
        style="@style/Widget.Attendra.FieldLabel"
        android:layout_marginTop="14dp"
        android:labelFor="@id/input_student"
        android:text="@string/manual_student" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_student"
        style="@style/Widget.Attendra.TextInput.Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/input_student"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/manual_student_hint"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/Widget.Attendra.FieldLabel"
        android:layout_marginTop="14dp"
        android:text="@string/manual_status" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chips_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_present"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/status_present" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_late"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/status_late" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        style="@style/Widget.Attendra.FieldLabel"
        android:layout_marginTop="14dp"
        android:labelFor="@id/input_reason"
        android:text="@string/manual_reason" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:counterEnabled="true"
        app:counterMaxLength="120">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/manual_reason_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="120"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="16dp"
        android:text="@string/name_save" />
</LinearLayout>
