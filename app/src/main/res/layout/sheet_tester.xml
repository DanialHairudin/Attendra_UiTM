<?xml version="1.0" encoding="utf-8"?>
<!-- "Tester access" bottom sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/tester_title"
        android:textAppearance="@style/TextAppearance.Attendra.CardTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tester_body"
        android:textAppearance="@style/TextAppearance.Attendra.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_test_lecturer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="16dp"
        android:text="@string/tester_login_lecturer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_test_student"
        style="@style/Widget.Attendra.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="12dp"
        android:text="@string/tester_login_student" />
</LinearLayout>
