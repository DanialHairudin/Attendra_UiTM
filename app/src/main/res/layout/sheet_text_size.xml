<?xml version="1.0" encoding="utf-8"?>
<!-- "Text size" bottom sheet in Settings: a live preview, a 4-step slider (Small, Default, Large,
     Extra large) and Apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/text_size"
        android:textAppearance="@style/TextAppearance.Attendra.CardTitle" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Attendra.Card.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_size_preview_title"
                android:textAppearance="@style/TextAppearance.Attendra.H2" />

            <TextView
                android:id="@+id/preview_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/text_size_preview_body"
                android:textAppearance="@style/TextAppearance.Attendra.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txt_level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Attendra.Body.SemiBold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/text_size_smaller"
            android:text="@string/text_size_sample"
            android:textAppearance="@style/TextAppearance.Attendra.Body"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/text_size"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/text_size_larger"
            android:text="@string/text_size_sample"
            android:textAppearance="@style/TextAppearance.Attendra.Body"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_size_note"
        android:textAppearance="@style/TextAppearance.Attendra.Caption" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="16dp"
        android:text="@string/text_size_apply" />
</LinearLayout>
