<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+): solid gold background with the cream
     Attendra mark on top. The mark is scaled to sit inside the 66dp safe zone,
     so no launcher mask (circle, squircle, teardrop) clips it. The monochrome
     layer is used for Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
