<?xml version="1.0" encoding="utf-8"?>
<!-- Shared component styles ("Shapes and components"). -->
<resources>

    <!-- Default TextView: Default font body text. -->
    <style name="Widget.Attendra.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Body</item>
    </style>

    <!-- Card: square white box with a thin grey border -->
    <style name="Widget.Attendra.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <!-- Card at the top of home screens: same as a normal card -->
    <style name="Widget.Attendra.Card.Hero">
        <item name="cardCornerRadius">@dimen/hero_radius</item>
        <item name="cardBackgroundColor">@color/hero</item>
        <item name="strokeColor">@color/heroLine</item>
    </style>

    <!-- Primary button: gold fill, white text. -->
    <style name="Widget.Attendra.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Button</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Secondary button: transparent with a line-coloured outline -->
    <style name="Widget.Attendra.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Button</item>
        <item name="rippleColor">@color/gold_tint</item>
    </style>

    <!-- Text link button ("Forgot password?") -->
    <style name="Widget.Attendra.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/goldText</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Body.SemiBold</item>
        <item name="rippleColor">@color/gold_tint</item>
    </style>

    <!-- Pill: selectable chip, one line. -->
    <style name="Widget.Attendra.Pill" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">38dp</item>
        <item name="chipCornerRadius">0dp</item>
        <item name="chipBackgroundColor">@color/pill_bg</item>
        <item name="chipStrokeColor">@color/pill_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Body.SemiBold</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Status badges: coloured text on a 12% tint of the same colour -->
    <style name="Widget.Attendra.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Attendra.Badge.Present">
        <item name="android:textColor">@color/present</item>
        <item name="android:backgroundTint">@color/present_tint</item>
    </style>

    <style name="Widget.Attendra.Badge.Late">
        <item name="android:textColor">@color/late</item>
        <item name="android:backgroundTint">@color/late_tint</item>
    </style>

    <style name="Widget.Attendra.Badge.Absent">
        <item name="android:textColor">@color/absent</item>
        <item name="android:backgroundTint">@color/absent_tint</item>
    </style>

    <!-- Plain grey badge (e.g. "Elective · Big Data") -->
    <style name="Widget.Attendra.Badge.Neutral">
        <item name="android:textColor">@color/ink</item>
        <item name="android:backgroundTint">@color/line</item>
    </style>

    <!-- List row: at least 56dp tall -->
    <style name="Widget.Attendra.ListRow" parent="">
        <item name="android:minHeight">@dimen/list_row_min_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Bottom nav: plain white bar, the active item is gold (no highlight shape) -->
    <style name="Widget.Attendra.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">8dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Attendra.BottomNav.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Attendra.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Attendra.NavLabel</item>
    </style>

    <style name="Widget.Attendra.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Text field: just a line under the text (no box), gold when focused -->
    <style name="Widget.Attendra.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/field_bg</item>
        <!-- Text starts at the left edge, in line with the underline and other labels -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.Attendra.TextInput</item>
        <item name="hintTextColor">@color/goldText</item>
        <item name="hintEnabled">true</item>
        <!-- Prefix such as "+60": Material styles it as textAppearanceTitleMedium, which our theme
             maps to the bold card-title font. -->
        <item name="prefixTextAppearance">@style/TextAppearance.Attendra.Body</item>
        <item name="prefixTextColor">@color/ink</item>
        <item name="startIconTint">@color/muted</item>
        <item name="endIconTint">@color/muted</item>
    </style>

    <!-- No left/right padding inside text fields -->
    <style name="ThemeOverlay.Attendra.TextInput" parent="ThemeOverlay.Material3.TextInputEditText.FilledBox">
        <item name="editTextStyle">@style/Widget.Attendra.EditText</item>
    </style>

    <style name="Widget.Attendra.EditText" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>
</resources>
