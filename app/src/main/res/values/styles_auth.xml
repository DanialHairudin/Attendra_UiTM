<?xml version="1.0" encoding="utf-8"?>
<!-- Styles added in for forms: field labels, dropdowns, the role toggle and the square back button. -->
<resources>

    <!-- Label above a field ("Full name"), 13sp SemiBold -->
    <style name="TextAppearance.Attendra.Label" parent="TextAppearance.Attendra.Caption">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Attendra.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Label</item>
    </style>

    <!-- Dropdown (Programme / Part / Group): same underline look as the text fields -->
    <style name="Widget.Attendra.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/field_bg</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Attendra.Dropdown</item>
        <item name="hintEnabled">true</item>
        <item name="endIconTint">@color/muted</item>
    </style>

    <!-- Role toggle (Student | Lecturer): one segment of the pill-shaped control. -->
    <style name="Widget.Attendra.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Body.SemiBold</item>
        <item name="rippleColor">@color/gold_tint</item>
    </style>

    <!-- Plain back arrow (no box around it) -->
    <style name="Widget.Attendra.IconButton" parent="Widget.Attendra.Button.Secondary">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/ink</item>
    </style>

    <!-- One box of the 6-digit code (Verify screen). -->
    <style name="Widget.Attendra.CodeBox" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_code_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:importantForAutofill">no</item>
        <!-- The hint ("Digit 1 of 6") is for TalkBack only, so it is invisible. -->
        <item name="android:textColorHint">@android:color/transparent</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Number</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- No left padding inside dropdowns, same as text fields -->
    <style name="ThemeOverlay.Attendra.Dropdown" parent="ThemeOverlay.Material3.AutoCompleteTextView.FilledBox">
        <item name="autoCompleteTextViewStyle">@style/Widget.Attendra.Dropdown.Text</item>
    </style>

    <style name="Widget.Attendra.Dropdown.Text" parent="Widget.Material3.AutoCompleteTextView.FilledBox">
        <item name="android:paddingStart">0dp</item>
    </style>
</resources>
