<?xml version="1.0" encoding="utf-8"?>
<!-- Styles added in C3 for forms: field labels, dropdowns, the role toggle and the
     square back button. Shared component styles from C2 live in styles.xml. -->
<resources>

    <!-- Label above a field ("Full name"), 13sp SemiBold like the prototype -->
    <style name="TextAppearance.Attendra.Label" parent="TextAppearance.Attendra.Caption">
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Attendra.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Label</item>
    </style>

    <!-- Exposed dropdown (Programme / Part / Group) with the same shape as text fields -->
    <style name="Widget.Attendra.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintEnabled">false</item>
        <item name="endIconTint">@color/muted</item>
    </style>

    <!-- Role toggle (Student | Lecturer): one segment of the pill-shaped control.
         Checked = surface fill + ink text, unchecked = transparent + muted text. -->
    <style name="Widget.Attendra.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">11dp</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Attendra.Body.SemiBold</item>
        <item name="rippleColor">@color/gold_tint</item>
    </style>

    <!-- 44dp square outlined back button, like the prototype's .iconbtn -->
    <style name="Widget.Attendra.IconButton" parent="Widget.Attendra.Button.Secondary">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/ink</item>
    </style>
</resources>
