<?xml version="1.0" encoding="utf-8"?>
<!-- Type scale from CLAUDE.md section 3. -->
<resources>
    <!-- Headings: Plus Jakarta Sans ExtraBold -->
    <style name="TextAppearance.Attendra.H1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Attendra.H2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Splash title: a bigger H1 (44sp in the prototype) -->
    <style name="TextAppearance.Attendra.Display" parent="TextAppearance.Attendra.H1">
        <item name="android:textSize">44sp</item>
    </style>

    <style name="TextAppearance.Attendra.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- Body: Manrope -->
    <style name="TextAppearance.Attendra.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Attendra.Body.Muted">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="TextAppearance.Attendra.Body.SemiBold">
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="TextAppearance.Attendra.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Small gold all-caps label above headings ("WELCOME BACK") -->
    <style name="TextAppearance.Attendra.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/manrope_bold</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/goldText</item>
    </style>

    <!-- Big numbers: Manrope ExtraBold with tabular figures ("tnum") so digits line up -->
    <style name="TextAppearance.Attendra.Number" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/manrope_extrabold</item>
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Attendra.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/manrope_semibold</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
